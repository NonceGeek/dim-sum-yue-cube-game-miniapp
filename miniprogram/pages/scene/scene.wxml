<page-meta page-style="background-color: {{currentTheme === 'dark' ? '#0D1117' : '#F5F7FA'}}; overflow: hidden;" />
<view class="container-wrap theme-{{currentTheme}}">
  <page-wrapper refresherEnabled="{{true}}" refreshing="{{refreshing}}" bind:refresh="onSceneRefresh" currentTheme="{{currentTheme}}" themeMode="{{themeMode}}" pageIcon="{{pageIcon}}" pageText="{{pageText}}">
    <!-- 首页内容插槽 -->
    <view slot="page-content">
      <view class="title">选择场景</view>
      <t-cell-group class="custom-cell-group">
        <view wx:for="{{sceneList}}" wx:key="id"
          class="cell-wrapper {{showAnimation ? 'cell-anim' : ''}} {{activeCell === item.id ? 'active' : ''}}"
          style="animation-delay: {{index * 0.15}}s"
          bind:tap="onSceneCellTap" data-category="{{item.scene}}" data-id="{{item.id}}" data-total="{{item.total}}">
          <t-cell bordered="{{false}}" title="{{item.scene}}" leftIcon="{{item.icon}}" description="{{item.total ? item.description : ''}}" hover
            class="custom-cell" />
        </view>
      </t-cell-group>
    </view>
  </page-wrapper>
</view>